# Caminho base da aplicação no servidor (ex: /fzl-disponibilidade/)
VITE_BASE_PATH=/

# Opcional: Provedor Supabase (se preenchido, substitui o localProvider de demonstração do AppShell
# e sincroniza as disponibilidades na tabela `student_availabilities`)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: API REST de Backend para sincronização de disponibilidades
VITE_API_BASE_URL=

# Lista opcional de e-mails de professores/coordenadores separados por vírgula
# (no modo demonstração local, qualquer usuário logado também pode alternar/visualizar o painel do professor)
VITE_TEACHER_EMAILS=professor@escola.edu.br,coordenador@escola.edu.br
